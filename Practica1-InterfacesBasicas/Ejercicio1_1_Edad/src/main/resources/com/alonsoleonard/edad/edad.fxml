<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="260.0" prefWidth="420.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alonsoleonard.edad.EdadController">
   <children>
      <Label layoutX="30.0" layoutY="40.0" text="Fecha de nacimiento">
         <font><Font size="16.0" /></font>
      </Label>
      <TextField fx:id="txtFecha" layoutX="220.0" layoutY="36.0" prefWidth="160.0" promptText="dd/mm/aaaa" />
      <Button layoutX="30.0" layoutY="100.0" onAction="#calcular" prefWidth="100.0" text="Calcular" />
      <Button layoutX="150.0" layoutY="100.0" onAction="#limpiar" prefWidth="100.0" text="Limpiar" />
      <Label fx:id="lblResultado" alignment="CENTER" layoutX="20.0" layoutY="170.0" prefWidth="380.0" style="-fx-font-style: italic;">
         <font><Font size="18.0" /></font>
      </Label>
   </children>
</AnchorPane>
