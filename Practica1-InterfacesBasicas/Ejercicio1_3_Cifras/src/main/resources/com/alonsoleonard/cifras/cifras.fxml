<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="620.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alonsoleonard.cifras.CifrasController">
   <children>
      <Label layoutX="20.0" layoutY="24.0" text="Ingrese un número" />
      <TextField fx:id="txtNumero" layoutX="150.0" layoutY="20.0" prefWidth="160.0" />
      <Button layoutX="380.0" layoutY="20.0" onAction="#analizar" prefWidth="100.0" text="Analizar" />
      <Button layoutX="495.0" layoutY="20.0" onAction="#limpiar" prefWidth="100.0" text="Limpiar" />

      <Label layoutX="20.0" layoutY="104.0" text="Cantidad de cifras" />
      <TextField fx:id="txtCantidad" editable="false" layoutX="180.0" layoutY="100.0" prefWidth="130.0" />
      <Label layoutX="20.0" layoutY="144.0" text="Suma de cifras impares" />
      <TextField fx:id="txtImpares" editable="false" layoutX="180.0" layoutY="140.0" prefWidth="130.0" />
      <Label layoutX="20.0" layoutY="184.0" text="Suma de cifras pares" />
      <TextField fx:id="txtPares" editable="false" layoutX="180.0" layoutY="180.0" prefWidth="130.0" />
      <Label layoutX="20.0" layoutY="224.0" text="Suma total de cifras" />
      <TextField fx:id="txtTotal" editable="false" layoutX="180.0" layoutY="220.0" prefWidth="130.0" />
      <Label layoutX="20.0" layoutY="264.0" text="Cifra mayor" />
      <TextField fx:id="txtMayor" editable="false" layoutX="180.0" layoutY="260.0" prefWidth="130.0" />
      <Label layoutX="20.0" layoutY="304.0" text="Cifra menor" />
      <TextField fx:id="txtMenor" editable="false" layoutX="180.0" layoutY="300.0" prefWidth="130.0" />

      <Label layoutX="380.0" layoutY="104.0" text="Divisores" />
      <TextArea fx:id="txtDivisores" editable="false" layoutX="380.0" layoutY="130.0" prefHeight="200.0" prefWidth="215.0" />
   </children>
</AnchorPane>
