<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="420.0" prefWidth="320.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alonsoleonard.tabla.TablaController">
   <children>
      <Label layoutX="30.0" layoutY="30.0" text="Tabla del:" />
      <TextField fx:id="txtNumero" layoutX="30.0" layoutY="60.0" prefWidth="60.0" />
      <Button layoutX="190.0" layoutY="30.0" onAction="#calcular" prefWidth="100.0" text="Calcular" />
      <Button layoutX="190.0" layoutY="75.0" onAction="#limpiar" prefWidth="100.0" text="Limpiar" />
      <TextArea fx:id="txtTabla" editable="false" layoutX="30.0" layoutY="130.0" prefHeight="260.0" prefWidth="260.0" />
   </children>
</AnchorPane>
