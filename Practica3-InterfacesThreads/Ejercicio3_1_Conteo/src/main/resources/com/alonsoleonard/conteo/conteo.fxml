<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" prefHeight="400.0" prefWidth="420.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alonsoleonard.conteo.ConteoController">
   <children>
      <Label text="Contar número de clics" />
      <TextField fx:id="txtClics" editable="false" promptText="0" />
      <Button onAction="#contar" prefWidth="120.0" text="¡Contar!" />
      <Label text="Esperar 10 segundos">
         <VBox.margin><Insets top="30.0" /></VBox.margin>
      </Label>
      <ProgressBar fx:id="barra" maxWidth="Infinity" progress="0.0" />
      <Button fx:id="btnEsperar" onAction="#esperar" prefWidth="120.0" text="¡Esperar!" />
   </children>
   <padding>
      <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
   </padding>
</VBox>
