<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" prefHeight="340.0" prefWidth="520.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alonsoleonard.carrera.CarreraController">
   <children>
      <Label text="La Liebre y la Tortuga">
         <font><Font size="18.0" /></font>
      </Label>
      <Button fx:id="btnIniciar" onAction="#iniciar" text="¡Iniciar Carrera!" />
      <Label fx:id="lblLiebre" text="La Liebre" />
      <ProgressBar fx:id="barraLiebre" maxWidth="Infinity" progress="0.0" />
      <Label fx:id="lblTortuga" text="La Tortuga" />
      <ProgressBar fx:id="barraTortuga" maxWidth="Infinity" progress="0.0" />
      <Label fx:id="lblGanador" style="-fx-font-weight: bold;" />
   </children>
   <padding>
      <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
   </padding>
</VBox>
